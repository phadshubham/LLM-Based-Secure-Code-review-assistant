# ==============================================================================
# Git Ignore - Secure Code Review Assistant
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Secrets
.env
backend/.env
frontend/.env
*.env.local
*.env.*.local
!*.env.example
*.pem
*.key
*.cert

# Application Storage & Runtime Artifacts
storage/*.db
storage/*.db-journal
storage/*.sqlite
storage/*.sqlite3
storage/uploads/*
!storage/uploads/.gitkeep
storage/projects/*
!storage/projects/.gitkeep
storage/reports/*
!storage/reports/.gitkeep

# IDEs & Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Logs
*.log
logs/
